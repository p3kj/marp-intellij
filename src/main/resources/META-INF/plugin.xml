<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin url="https://github.com/p3kj/marp-intellij">
    <id>cz.p3kj.marp</id>
    <name>Marp Preview</name>
    <vendor email="p3k.jaros@gmail.com" url="https://github.com/p3kj/marp-intellij">p3kj</vendor>
    <description><![CDATA[
        <p>Live preview for <a href="https://marp.app">Marp</a> slide decks, right next to the Markdown editor, in every JetBrains IDE.</p>
        <p>Open a Markdown file whose front matter contains <code>marp: true</code> and it gets an Editor / Split / Preview toggle. The preview refreshes while you type, no save needed.</p>
        <p><b>Features</b></p>
        <ul>
            <li><b>Live preview</b> rendered by <a href="https://github.com/marp-team/marp-core">marp-core</a> inside the IDE's built-in browser (JCEF). No Node.js, no Marp CLI, no external process.</li>
            <li><b>Scroll sync</b> in both directions, the slide under the caret is highlighted, double-click a slide to jump to its source line. Toolbar toggles for scroll sync and presenter notes.</li>
            <li><b>Custom themes</b> from CSS files, folders or URLs (the same entries as <code>markdown.marp.themes</code> in VS Code), plus automatic pickup of <code>themeSet</code> from <code>.marprc.yml</code>. Theme edits show up live.</li>
            <li><b>Directives</b> in HTML comments and in the front matter: completion, hover docs and an inspection (unknown names, <code>_theme</code>, invalid <code>paginate</code>, <code>math</code> and <code>headingDivider</code> values), and highlighting in comments. Unknown theme names are reported with quick fixes to add a theme.</li>
            <li><b>Local images</b> with relative paths, <code>![bg](...)</code> backgrounds, fitting headers, Twemoji.</li>
            <li><b>Math</b> with MathJax (works offline) or KaTeX.</li>
            <li><b>Inline HTML</b> in slides: off, Marp's safe allow list, or all. Untrusted projects render without HTML and without remote themes.</li>
            <li><b>Slide navigation</b>: current slide in the status bar, Next / Previous Slide and Go to Slide, slide numbers in the editor, and folding of each slide.</li>
            <li><b>New deck and live templates</b>: File | New | Marp Presentation, and <code>slide</code>, <code>lead</code>, <code>bg</code> and <code>notes</code> live templates in Marp decks.</li>
            <li>The preview follows the IDE light or dark theme. Links open in the IDE (project files) or in the system browser.</li>
        </ul>
        <p>Settings: <b>Settings | Tools | Marp</b>.</p>
        <p><a href="https://github.com/p3kj/marp-intellij">Source code</a> (MIT) |
        <a href="https://github.com/p3kj/marp-intellij/issues">Issues</a> |
        <a href="https://github.com/p3kj/marp-intellij/blob/main/CHANGELOG.md">Changelog</a></p>
        <p>Marp Preview is an independent project and is not affiliated with the Marp team.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.jcef</depends>
    <depends>org.intellij.plugins.markdown</depends>
    <!-- Optional: without the spellchecker module the plugin just skips its Marp dictionary. -->
    <depends optional="true" config-file="marp-spellchecker.xml">com.intellij.modules.spellchecker</depends>

    <resource-bundle>messages.MarpBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Editor and preview -->
        <fileEditorProvider id="marp-preview-editor"
                            implementation="cz.p3kj.marp.editor.MarpSplitEditorProvider"
                            isDocumentRequired="true"/>
        <editorNotificationProvider implementation="cz.p3kj.marp.notifications.MarpEditorNotificationProvider"/>
        <editorFactoryDocumentListener implementation="cz.p3kj.marp.notifications.MarpNotificationDocumentListener"/>

        <!-- Slide navigation: "Slide 3 / 12" in the status bar, shown only while a Marp deck is in the editor -->
        <statusBarWidgetFactory id="Marp.SlidePosition"
                                implementation="cz.p3kj.marp.navigation.MarpSlideWidgetFactory"
                                order="before Position"/>

        <!-- Slide numbers at the end of the line where each slide starts, switchable in Settings | Editor | Inlay Hints -->
        <codeInsight.declarativeInlayProvider language="Markdown"
                                              implementationClass="cz.p3kj.marp.navigation.MarpSlideNumberInlayProvider"
                                              isEnabledByDefault="true"
                                              group="OTHER_GROUP"
                                              providerId="marp.slideNumbers"
                                              bundle="messages.MarpBundle"
                                              nameKey="inlay.slideNumbers.name"
                                              descriptionKey="inlay.slideNumbers.description"/>

        <!-- One folding region per slide of a Marp deck. First, so it wins over Markdown heading regions that cross a slide boundary -->
        <lang.foldingBuilder language="Markdown" order="first" implementationClass="cz.p3kj.marp.folding.MarpSlideFoldingBuilder"/>

        <!-- Settings and themes -->
        <projectConfigurable
                parentId="tools"
                id="cz.p3kj.marp.settings"
                instance="cz.p3kj.marp.settings.MarpConfigurable"
                key="settings.displayName"
                bundle="messages.MarpBundle"/>

        <!-- New deck and live templates -->
        <internalFileTemplate name="Marp Presentation"/>
        <defaultLiveTemplates file="/liveTemplates/Marp.xml"/>
        <liveTemplateContext contextId="MARP_DECK"
                             baseContextId="MARKDOWN"
                             implementation="cz.p3kj.marp.templates.MarpTemplateContextType"/>

        <!-- Directive comments -->
        <annotator language="Markdown" implementationClass="cz.p3kj.marp.directives.MarpDirectiveAnnotator"/>
        <colorSettingsPage implementation="cz.p3kj.marp.directives.MarpColorSettingsPage"/>
        <completion.contributor language="any" order="first" implementationClass="cz.p3kj.marp.directives.MarpDirectiveCompletionContributor"/>
        <completion.confidence language="any" order="first" implementationClass="cz.p3kj.marp.directives.MarpDirectiveCompletionConfidence"/>
        <platform.backend.documentation.targetProvider implementation="cz.p3kj.marp.directives.MarpDirectiveDocumentationTargetProvider"/>
        <gotoDeclarationHandler implementation="cz.p3kj.marp.directives.MarpThemeGotoDeclarationHandler"/>
        <localInspection language="Markdown" shortName="MarpDirective" bundle="messages.MarpBundle" key="inspection.directive.name"
                         groupKey="inspection.group" enabledByDefault="true" level="WARNING" dumbAware="true"
                         implementationClass="cz.p3kj.marp.directives.MarpDirectiveInspection"/>
        <localInspection language="Markdown" shortName="MarpUnknownTheme" bundle="messages.MarpBundle" key="inspection.unknownTheme.name"
                         groupKey="inspection.group" enabledByDefault="true" level="WARNING" dumbAware="true"
                         implementationClass="cz.p3kj.marp.directives.MarpUnknownThemeInspection"/>

        <!-- Image syntax -->
        <completion.contributor language="any" order="first" implementationClass="cz.p3kj.marp.images.MarpImageCompletionContributor"/>
        <completion.confidence language="any" order="first" implementationClass="cz.p3kj.marp.images.MarpImageCompletionConfidence"/>
        <platform.backend.documentation.targetProvider implementation="cz.p3kj.marp.images.MarpImageDocumentationTargetProvider"/>
    </extensions>

    <actions>
        <!-- Shown in the floating toolbar of the Marp editor, see MarpSplitEditor.createRightToolbarActionGroup. The synonyms make the toggles findable by "marp" in Find Action. -->
        <group id="Marp.PreviewToolbar">
            <action id="Marp.ToggleScrollSync"
                    class="cz.p3kj.marp.editor.MarpScrollSyncToggleAction"
                    icon="AllIcons.Actions.SynchronizeScrolling">
                <synonym key="action.Marp.ToggleScrollSync.synonym"/>
            </action>
            <action id="Marp.TogglePresenterNotes"
                    class="cz.p3kj.marp.editor.MarpPresenterNotesToggleAction"
                    icon="AllIcons.General.Note">
                <synonym key="action.Marp.TogglePresenterNotes.synonym"/>
            </action>
            <separator/>
            <action id="Marp.OpenSettings"
                    class="cz.p3kj.marp.editor.MarpOpenSettingsAction"
                    icon="AllIcons.General.Settings"/>
        </group>

        <!-- Navigate | Marp slide actions, only enabled in the editor of a Marp deck. The default shortcuts are taken by the bundled
             NetBeans and Visual Studio keymaps, so those two get them removed instead of a clash. Go to Slide has none: Ctrl+G is Go to Line. -->
        <group id="Marp.SlideNavigation">
            <separator/>
            <action id="Marp.PreviousSlide" class="cz.p3kj.marp.navigation.MarpPreviousSlideAction">
                <keyboard-shortcut keymap="$default" first-keystroke="control alt PAGE_UP"/>
                <keyboard-shortcut keymap="NetBeans 6.5" first-keystroke="control alt PAGE_UP" remove="true"/>
                <keyboard-shortcut keymap="Visual Studio" first-keystroke="control alt PAGE_UP" remove="true"/>
                <keyboard-shortcut keymap="Visual Studio OSX" first-keystroke="meta alt PAGE_UP" remove="true"/>
                <synonym key="action.Marp.PreviousSlide.synonym"/>
            </action>
            <action id="Marp.NextSlide" class="cz.p3kj.marp.navigation.MarpNextSlideAction">
                <keyboard-shortcut keymap="$default" first-keystroke="control alt PAGE_DOWN"/>
                <keyboard-shortcut keymap="NetBeans 6.5" first-keystroke="control alt PAGE_DOWN" remove="true"/>
                <keyboard-shortcut keymap="Visual Studio" first-keystroke="control alt PAGE_DOWN" remove="true"/>
                <keyboard-shortcut keymap="Visual Studio OSX" first-keystroke="meta alt PAGE_DOWN" remove="true"/>
                <synonym key="action.Marp.NextSlide.synonym"/>
            </action>
            <action id="Marp.GoToSlide" class="cz.p3kj.marp.navigation.MarpGoToSlideAction">
                <synonym key="action.Marp.GoToSlide.synonym"/>
            </action>
            <add-to-group group-id="GoToMenu" anchor="last"/>
        </group>

        <!-- File | New | Marp Presentation, creates a deck from the internal file template of the same name. -->
        <action id="Marp.NewPresentation"
                class="cz.p3kj.marp.templates.MarpNewPresentationAction"
                icon="AllIcons.FileTypes.Markdown">
            <synonym key="action.Marp.NewPresentation.synonym"/>
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewDir"/>
        </action>
    </actions>
</idea-plugin>
